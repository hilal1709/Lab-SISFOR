# Database Configuration
# For local dev, set both vars to your local database connection string.
POSTGRES_PRISMA_URL="postgresql://postgres:hilal123@localhost:5432/sisfor_lab"
POSTGRES_URL_NON_POOLING="postgresql://postgres:hilal123@localhost:5432/sisfor_lab"

# NextAuth Configuration
NEXTAUTH_SECRET="change-this-to-a-random-string-generate-with-openssl-rand-base64-32"

# API Configuration
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Admin dashboard login (/admin/login) — must match values you use in the form
ADMIN_ID="admin@sisfor.lab"
ADMIN_KEY="use-a-strong-password-in-production"

# If you run `next start` over http://localhost, set false or the session cookie is dropped by the browser
# ADMIN_COOKIE_SECURE=false
